# OpenRouter settings (required to generate plans)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# SMTP settings (required only when "Email me a copy" is selected)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Use true with implicit TLS providers/port 465. Otherwise the app requires STARTTLS.
SMTP_USE_SSL=false
